{% extends 'base_template.html.twig' %}

{% block title %}Problèmes{% endblock %}

{% block content %}
    <main>
        <h1>Problèmes</h1>
        {% for probleme in problemes %}
            <div>
                <h2>{{ probleme.titre }}</h2>
                <p>Id : {{ probleme.id }}</p>
                <p>Description : {{ probleme.description }}</p>
                <p>Catégories :
                    {% for categorie in probleme.categories %}
                        {{ categorie.libelle }}
                        {% if not loop.last %}
                            ,
                        {% endif %}
                    {% else %}
                        Non Catégorisé
                    {% endfor %}
                </p>
                <p>Type : 
                    {% if probleme.type %}
                    signalement
                    {% else %}
                    idée
                    {% endif %}
                </p>
                <p>Date : {{ probleme.dateHeure|date('d/m/Y à H:i') }}</p>
                <p>Upvotes : {{ probleme.upvote }} | Downvotes : {{ probleme.downvote }}</p>
                <p>État : {{ probleme.etat }}</p>
                <p>Chemins photos :</p>
                <ul>
                    {% for media in probleme.medias %}
                        {% if media.type %}
                            <li>
                                <img src="{{ media.url }}">
                            </li>
                        {% else %}
                            <li>
                                <video controls width="640">
                                    <source src="{{ media.url }}" type="video/mp4">
                                </video>
                            </li>
                        {% endif %}
                    {% else %}
                        <li>Aucune photo</li>
                    {% endfor %}
                </ul>
            </div>
            <hr>
        {% else %}
            <p>Aucun probleme.</p>
        {% endfor %}
    </main>
{% endblock %}