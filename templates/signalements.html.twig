{% extends 'base_template.html.twig' %}

{% block title %}Signalements{% endblock %}

{% block content %}
    <main>
        <h1>Signalements</h1>
        {% for signalement in signalements %}
            <div>
                <h2>{{ signalement.titre }}</h2>
                <p>Id : {{ signalement.id }}</p>
                <p>Description : {{ signalement.description }}</p>
                <p>Catégorie : {{ signalement.categorie.libelle ?? 'Non catégorisé' }}</p>
                <p>Date : {{ signalement.dateHeure|date('d/m/Y à H:i') }}</p>
                <p>Upvotes : {{ signalement.upvote }} | Downvotes : {{ signalement.downvote }}</p>
                <p>Chemins photos :</p>
                <ul>
                    {% for photo in signalement.photos %}
                        <li>
                            <img src="{{ photo.url }}">
                        </li>
                    {% else %}
                        <li>Aucune photo</li>
                    {% endfor %}
                </ul>
            </div>
            <hr>
        {% else %}
            <p>Aucun signalement.</p>
        {% endfor %}
    </main>
{% endblock %}